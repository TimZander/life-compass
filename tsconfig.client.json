{
  // Client code is checked here and emitted by build/client.ts.
  //
  // docs/decisions/0002 chose JSDoc for this tier while browsers loaded the modules as
  // written, and named the storage work as the moment that arrangement ends. 0012 is
  // that decision. Checking still happens here and only here — the emit strips types and
  // never looks at them — so this file remains the only thing standing between a type
  // error and production.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    // nodenext, not bundler. "bundler" resolution accepts `from "./sw-update"` — a
    // specifier no browser can resolve, because nothing is bundling this. The typecheck
    // is the only guard on this tier, so accepting an import that 404s means a missing
    // ".js" disables every client module in production while every check passes.
    // Node's ESM resolution matches the browser's for relative specifiers: the extension
    // is required and the file must exist.
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "noEmit": true,
    // The emit is erasure and nothing else, so nothing may need more than erasure.
    // Without this an enum would typecheck here and emit as a runtime object that
    // build/client.ts does not produce, and the module would break in the browser.
    "erasableSyntaxOnly": true,
    // The emit preserves every import exactly as written, so this must too, or the two
    // disagree about what an import means. Without it `import { BannerMessage }` — a type
    // imported as a value — typechecks here and is emitted verbatim, and the browser
    // answers with "does not provide an export named BannerMessage". app.js is the entry
    // module, so that one line takes the banner, update prompting and worker
    // registration down together. Requiring `import type` is what keeps them in step.
    "verbatimModuleSyntax": true,
    // Every relative import in this tier — module and test alike — says `.ts`, and the
    // emit rewrites it to `.js`. Node runs these files from source, so `.ts` is what it
    // can resolve; a browser needs `.js` or it 404s.
    //
    // This file emits nothing, so the setting here only lets the checker accept the `.ts`
    // specifiers. The rewrite that ships is build/client.ts's, and that is where the guard
    // points: buildClient_RealRoot_EmitsEveryModuleAsBrowserReadyJavaScript rejects any
    // relative specifier in EMITTED output not ending in `.js`. Checking the source
    // instead would prove only that somebody typed the extension correctly.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,

    "skipLibCheck": true
  },
  "include": ["src/client/**/*.ts"]
}
