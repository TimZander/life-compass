{
  // Client code is checked, not compiled.
  //
  // docs/decisions/0002 chose real TypeScript for the build because a build already
  // existed, and said plainly that JSDoc earns its syntax exactly when there is no
  // compile step. Client code is that case: browsers load these modules as written, so
  // annotating them buys type safety for no toolchain at all. When there is enough
  // client code to justify emitting — 0003 · C1a expects that at the storage work — this
  // is the file that decision replaces.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,

    "skipLibCheck": true
  },
  "include": ["assets/js/**/*.js"]
}
